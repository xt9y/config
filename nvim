-- telescope
-- NOTE: vim.uv.cwd() returns nil when the directory nvim is sitting in
-- was deleted/renamed out from under it. Telescope then crashes with
-- "path: expected string, got nil" (utils.lua path_expand). So every
-- telescope call below goes through safe_cwd() instead of relying on
-- the implicit cwd.
local function safe_cwd()
    if vim.uv.cwd() then
        return vim.uv.cwd()
    end
    local bufdir = vim.fn.expand("%:p:h")
    if bufdir ~= "" and vim.uv.fs_stat(bufdir) then
        return bufdir
    end
    return vim.fn.expand("~")
end

-- if we are already in a dead cwd at startup, get out of it so :make,
-- lsp root detection, etc. don't misbehave either
if not vim.uv.cwd() then
    vim.cmd.cd(vim.fn.expand("~"))
    vim.schedule(function()
        vim.notify("cwd no longer exists, moved to $HOME", vim.log.levels.WARN)
    end)
end

