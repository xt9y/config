-- telescope open helpers
local function open_in(split)
    return function()
        require("telescope.builtin").find_files({
            cwd = safe_cwd(),
            attach_mappings = function(prompt_bufnr, map)

                local open = function()
                    local sel = require("telescope.actions.state").get_selected_entry()
                    require("telescope.actions").close(prompt_bufnr)

                    if not sel then
                        return
                    end

                    local path = sel.path or sel.filename

                    if not path then
                        vim.notify("no path for selected entry", vim.log.levels.WARN)
                        return
                    end

                    if split == "v" then
                        vim.cmd.vsplit(vim.fn.fnameescape(path))
                    elseif split == "h" then
                        vim.cmd.split(vim.fn.fnameescape(path))
                    else
                        vim.cmd.edit(vim.fn.fnameescape(path))
                    end
                end

                map("i", "<CR>", open)
                map("n", "<CR>", open)

                return true
            end,
        })
    end
end


