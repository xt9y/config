#!/usr/bin/env python3
"""felix-format: clang-format + Felix's airy paragraph spacing.

Completly made by AI because wth is python and tf im not wasting my time on formatting my code lmao

Usage:
  felix-format [-i] [--check] [--diff] [--no-clang] file [file ...]
  felix-format < file.c            # stdin -> stdout

Pipeline per file: clang-format (embedded main.m style, always 4-space
tabs) -> if-brace attach (if/else K&R to match src/main.m) -> airy
blank-line pass.
The airy pass only ADDS single blank lines at statement boundaries and
preserves your manual single/double blanks (3+ collapse to 2). It never
joins lines, never reindents, never touches the inside of multi-line
calls / initializers / ternaries.

Style target is METAL src/main.m 100%: same spacing, same brace placement
(Allman for functions/for/while/autoreleasepool, K&R attach for if/else),
same blank-line paragraphs, but always with 4-space-wide tabs
(IndentWidth=4, TabWidth=4, UseTab=Never).
"""
import argparse
import difflib
import os
import re
import subprocess
import sys

CONTROL = ("if", "for", "while", "switch", "return", "break", "continue", "goto")
CONTROL_RE = re.compile(r"^(if|for|while|switch|return|break|continue|goto)\b")
HEADER_RE = re.compile(r"^(if|for|while|switch|else|do)\b")
CASE_RE = re.compile(r"^(case\b|default\b)")
# Fixed DECL_RE: old pattern greedily ate all but the last char of
# two-word decls without '*' (e.g. 'vector_float3 eye =' -> 'e',
# 'const float scale =' -> 'e'). New pattern forces Type (*|space) Name.
DECL_RE = re.compile(
    r"^\s*(?:(?:const|static|extern|register|volatile|inline|_Atomic"
    r"|unsigned|signed|long|short)\s+)*"
    r"[A-Za-z_]\w*"
    r"(?:\s*\*\s*|\s+)"
    r"(?P<name>[A-Za-z_]\w*)"
    r"\s*(?:\[[^\]]*\]\s*)*"
    r"\s*(?:=|;)"
)
# Embedded clang-format style reproducing METAL src/main.m 100%, but with
# 4-space-wide tabs always (IndentWidth=4, TabWidth=4, UseTab=Never).
# Derived by diffing clang-format outputs against src/main.m:
# - Allman brace break matches functions/for/@autoreleasepool in main.m
#   (if/else are re-attached afterwards to K&R to match main.m's single
#   'if (bloomStrength > 0) {').
# - ColumnLimit 0 keeps main.m's long single lines (e.g. 105-col addPost
#   signature, 101-col fmaxf scale line) unbroken.
# - BreakAfterOpenBracketBracedList/BreakBeforeCloseBracketBracedList keep
#   multi-line (Sky){...}, (Camera){...} etc. with closing '};' on its own
#   line at parent indent, exactly like main.m.
# - AllowShortIfStatementsOnASingleLine preserves 'if (!model) return 1;'.
FELIX_CLANG_STYLE = (
    "{BasedOnStyle: LLVM, "
    "BreakBeforeBraces: Allman, "
    "ColumnLimit: 0, "
    "IndentWidth: 4, TabWidth: 4, UseTab: Never, "
    "ContinuationIndentWidth: 4, "
    "ObjCBlockIndentWidth: 4, "
    "BracedInitializerIndentWidth: 4, "
    "ConstructorInitializerIndentWidth: 4, "
    "PPIndentWidth: 4, "
    "AccessModifierOffset: -4, "
    "PointerAlignment: Right, DerivePointerAlignment: false, "
    "SpaceBeforeParens: ControlStatements, "
    "SpaceBeforeCpp11BracedList: false, "
    "SpaceBeforeAssignmentOperators: true, "
    "AllowShortIfStatementsOnASingleLine: Always, "
    "AllowShortBlocksOnASingleLine: Always, "
    "AllowShortFunctionsOnASingleLine: All, "
    "BinPackArguments: true, BinPackParameters: true, "
    "BinPackLongBracedList: true, "
    "BreakAfterOpenBracketBracedList: true, "
    "BreakBeforeCloseBracketBracedList: true, "
    "BreakAdjacentStringLiterals: true, "
    "ObjCSpaceAfterProperty: false, ObjCSpaceBeforeProtocolList: true, "
    "ObjCBinPackProtocolList: Auto, "
    "LineEnding: LF}"
)
# A line ending in ';', '{', '}' or ':' is a complete statement boundary.
# Anything else (operators, commas, openers) means the statement continues.
CONT_START = (
    "?", ":", ",", ".", ")", "]", "*", "&", "|", "^", "%", "+",
    "-", "/", "<", ">", "=", "!",
)


def strip_code(s):
    """Remove string/char literals and // comments for brace counting."""
    out = []
    i, n = 0, len(s)
    quote = None
    while i < n:
        c = s[i]
        if quote:
            if c == "\\":
                i += 2
                continue
            if c == quote:
                quote = None
            i += 1
            continue
        if c in ("'", '"'):
            quote = c
            i += 1
            continue
        if c == "/" and i + 1 < n and s[i + 1] == "/":
            break
        out.append(c)
        i += 1
    return "".join(out)


def is_blank(s):
    return s.strip() == ""


def is_preproc(s):
    return s.lstrip().startswith("#")


def is_comment_only(s):
    t = s.lstrip()
    return t.startswith("//") or t.startswith("/*") or t.startswith("*")


def is_control(s):
    return bool(CONTROL_RE.match(s.lstrip()))


def is_decl(s):
    t = s.lstrip()
    if CONTROL_RE.match(t) or HEADER_RE.match(t) or CASE_RE.match(t):
        return False
    if t.startswith("}") or t.startswith("{"):
        return False
    return bool(DECL_RE.match(s))


def decl_name(s):
    m = DECL_RE.match(s)
    return m.group("name") if m else None


def depths(lines):
    """Paren/bracket/brace depth at the START of each line."""
    res = []
    paren = brack = brace = 0
    in_block = False
    for ln in lines:
        code = strip_code(ln)
        if in_block:
            end = code.find("*/")
            if end == -1:
                res.append((paren, brack, brace))
                continue
            code = code[end + 2 :]
            in_block = False
        while True:
            start = code.find("/*")
            if start == -1:
                break
            end = code.find("*/", start + 2)
            if end == -1:
                code = code[:start]
                in_block = True
                break
            code = code[:start] + code[end + 2 :]
        res.append((paren, brack, brace))
        paren += code.count("(") - code.count(")")
        brack += code.count("[") - code.count("]")
        brace += code.count("{") - code.count("}")
    return res


def collapse(lines):
    out = []
    blanks = 0
    for ln in lines:
        if is_blank(ln):
            blanks += 1
            if blanks <= 2:
                out.append("")
            continue
        blanks = 0
        out.append(ln.rstrip())
    while out and is_blank(out[0]):
        out.pop(0)
    while out and is_blank(out[-1]):
        out.pop()
    return out


def continuation_blocked(prev, cur, dprev, dcur):
    if dcur[0] != 0 or dcur[1] != 0 or dprev[0] != 0 or dprev[1] != 0:
        return True
    ps, cs = prev.rstrip(), cur.lstrip()
    if ps.endswith("\\"):
        return True
    if ps != "" and not ps.endswith((";", "{", "}", ":")):
        return True
    if cs.startswith(CONT_START):
        # ')'/']' start = end of a call, not a continuation; still glue it.
        return True
    return False


def prev_decl_run_names(lines, idx):
    names = []
    j = idx - 1
    while j >= 0 and len(names) < 12:
        s = lines[j]
        if is_blank(s) or is_preproc(s) or is_comment_only(s):
            break
        t = s.lstrip()
        if t.startswith(("{", "}", "#")) or HEADER_RE.match(t) or CASE_RE.match(t):
            break
        if not is_decl(s) or not s.rstrip().endswith(";"):
            break
        nm = decl_name(s)
        if nm:
            names.append(nm)
        j -= 1
    return names


def null_guard_lines(lines):
    """Original indices of 'if (!p)' / 'if (p == NULL)' null guards whose body
    is a single return: they stay glued to the alloc above them.
    Matches METAL src/main.m: both multi-line
      if (!x)
        return ...;
    and single-line
      if (!x) return ...;
      if (!x) x = ...;  (consecutive short guards glue together).
    """
    glued = set()
    for k, ln in enumerate(lines):
        if is_blank(ln) or not ln.lstrip().startswith("if"):
            continue
        j = k - 1
        while j >= 0 and is_blank(lines[j]):
            j -= 1
        if j < 0:
            continue
        # Single-line guard: 'if (!model) return 1;' contains its own body.
        # Glue it when it checks a var from the decl run above (main.m:
        # 'Model *model = ...;' directly followed by 'if (!model) return 1;'
        # with NO blank line).
        stripped = ln.lstrip()
        code = strip_code(ln).split("//")[0]
        m = re.match(r"^if\s*\(\s*!?\s*\(?\s*([A-Za-z_]\w*)", stripped)
        if not m:
            continue
        # Must contain '!' or 'NULL' to be a null check (like main.m).
        if "NULL" not in ln and "!" not in ln.split("//")[0]:
            # Still allow consecutive short ifs to glue (see below), but
            # only single-line null checks glue to a decl run.
            pass
        else:
            if j >= 0 and is_decl(lines[j]):
                names = prev_decl_run_names(lines, k)
                if m.group(1) in names:
                    # Single-line body on same line -> glued (main.m style).
                    if re.search(r"\)\s*[^;{]*\breturn\b", code) or re.search(
                        r"\)\s*[^;{}]*;", code
                    ):
                        glued.add(k)
                        continue
        # Multi-line guard: body is 'return' on the next non-blank line.
        if j < 0 or not is_decl(lines[j]):
            continue
        names = prev_decl_run_names(lines, k)
        if m.group(1) not in names:
            continue
        if "NULL" not in ln and "!" not in ln.split("//")[0]:
            continue
        # If the if already has its body on the same line, it was handled
        # above; here require the body to be on the following line.
        if re.search(r"\)\s*[^;{}]*;", code):
            # Same-line body already glued above; skip multi-line check.
            continue
        n = k + 1
        while n < len(lines) and is_blank(lines[n]):
            n += 1
        if n < len(lines) and lines[n].lstrip().startswith("return"):
            glued.add(k)
    return glued


def needs_blank_before(lines, i, dlist, glued=False):
    cur = lines[i]
    if is_blank(cur) or is_preproc(cur) or is_comment_only(cur):
        return False
    ct = cur.lstrip()
    if ct.startswith("}") or ct.startswith("{") or ct == ";" or ct.startswith(";"):
        return False
    if re.match(r"^else\b", ct):
        return False  # 'else' glues to '}'
    m_while = re.match(r"^while\b", ct)
    if m_while and ct.rstrip().endswith(";"):
        return False  # 'while' of do-while glues to '}'; a fresh loop falls through
    if CASE_RE.match(ct):
        return False
    # previous non-blank line
    j = i - 1
    while j >= 0 and is_blank(lines[j]):
        j -= 1
    if j < 0:
        return False
    prev = lines[j]
    if is_preproc(prev) or is_comment_only(prev):
        return False
    pt = prev.lstrip()
    if pt.endswith("{") or pt == "{":
        return False  # no blank at start of block
    if pt.endswith(":"):
        return False  # case label / label: glue body
    if HEADER_RE.match(pt) and (pt.endswith(")") or pt in ("else", "do")):
        return False  # control header + its body stay glued
    if continuation_blocked(prev, cur, dlist[j], dlist[i]):
        return False
    # main.m: consecutive single-line short ifs glue together, e.g.
    #   Model *model = ...;
    #   if (!model) return 1;
    #   if (!first) first = model;
    # with NO blanks. Suppress R1 blank when both prev and cur are
    # single-line 'if (... ) ...;' guards.
    if is_control(cur) and pt.startswith("if") and pt.rstrip().endswith(";"):
        if ct.startswith("if"):
            return False
    # R2: after a closed block
    if pt.startswith("}"):
        # main.m: '};' (end of multi-line initializer like
        # 'sky.sky = (Sky){...};') directly followed by ObjC message
        # '[world add:sky];' / '[renderer add:...];' stays GLUED (no blank).
        # Every other '};' -> decl transition keeps the blank, e.g.
        # 'const vector_float3 center = {...};' blank 'const float scale = ...'.
        if ct.startswith("["):
            return False
        return True
    # R1: before control statements (except malloc-style null guards)
    if is_control(cur):
        if glued:
            return False
        return True
    # R3a: executable -> new declaration run
    if is_decl(cur) and not is_decl(prev):
        return True
    # R3b: declaration run -> executable (unless it uses the declared var)
    if not is_decl(cur) and not is_control(cur) and is_decl(prev):
        code = strip_code(cur).split("//")[0]
        for nm in prev_decl_run_names(lines, i):
            if re.search(r"\b" + re.escape(nm) + r"\b", code):
                return False  # e.g. 'char title[];' + 'snprintf(... title ...)': keep glued
        return True
    # main.m: assignment with initializer (not a DECL, e.g.
    # 'sky.sky = (Sky){...};') + '[world add:sky];' that uses the assigned
    # object stays glued. Covers R2-exception above for non-decl assignments
    # and 'vector_float3 eye = ...;' + 'camera.transform = ...(eye,...)'.
    if ct.startswith("[") and "=" in pt:
        # Extract object before '.' or space, e.g. 'sky.sky =' -> 'sky'.
        mobj = re.match(r"^([A-Za-z_]\w*)", pt)
        if mobj and re.search(r"\b" + re.escape(mobj.group(1)) + r"\b", strip_code(cur)):
            return False
    return False


def airy_pass(text):
    lines = collapse(text.split("\n"))
    if not lines:
        return "\n"
    dlist = depths(lines)
    glued = null_guard_lines(lines)
    out = []
    dout = []
    for i, ln in enumerate(lines):
        if i > 0 and out and not is_blank(out[-1]):
            if needs_blank_before(out + [ln], len(out), dout + [dlist[i]], i in glued):
                out.append("")
                dout.append(dout[-1])
        out.append(ln)
        dout.append(dlist[i])
    return "\n".join(out) + "\n"


def fix_if_braces(text):
    """Re-attach K&R braces for if/else to match src/main.m 100%.

    clang-format runs with BreakBeforeBraces: Allman (functions/for/while/
    @autoreleasepool break onto their own line, exactly like main.m).
    main.m's single braced 'if (bloomStrength > 0) {' ATTACHES, while its
    'for (...) ' BREAKS. So after clang-format, join:
      if (cond)
      {
    -> if (cond) {
    Same for 'else if (...)', 'else'. 'for'/'while'/'switch'/functions stay
    broken (Allman). Always uses 4-space indents (no tabs).
    """
    lines = text.split("\n")
    out = []
    i = 0
    while i < len(lines):
        cur = lines[i]
        stripped = cur.lstrip()
        # Look ahead: 'if (...)', 'else if (...)', or 'else' alone on line,
        # followed by '{' alone on next line -> join to '... {'
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        if nxt.lstrip().strip() == "{" and (
            re.match(r"^if\s*\(.*\)\s*$", stripped)
            or re.match(r"^else\s+if\s*\(.*\)\s*$", stripped)
            or re.match(r"^else\s*$", stripped)
        ):
            indent = cur[: len(cur) - len(cur.lstrip())]
            # Enforce 4-space tabs: expand tabs, then re-indent with spaces.
            indent = indent.expandtabs(4)
            # Normalize indent to multiple of 4 (main.m uses 4-space levels).
            # clang-format already emits spaces; just ensure no tabs remain.
            joined = cur.rstrip() + " {"
            joined = joined.replace("\t", "    ")
            out.append(joined)
            i += 2
            continue
        out.append(cur.replace("\t", "    "))
        i += 1
    return "\n".join(out)


def run_clang_format(text, filename, exe="clang-format"):
    # Always enforce main.m style + 4-space-wide tabs, ignoring any repo
    # .clang-format. This reproduces METAL src/main.m 100% (same spacing,
    # same brace placement) but with IndentWidth=4.
    cmd = [
        exe,
        "--style=" + FELIX_CLANG_STYLE,
        "--assume-filename=" + os.path.abspath(filename),
    ]
    try:
        p = subprocess.run(
            cmd, input=text, capture_output=True, text=True,
            cwd=os.path.dirname(os.path.abspath(filename)) or ".",
        )
    except FileNotFoundError:
        print(f"felix-format: '{exe}' not found (use --no-clang)", file=sys.stderr)
        sys.exit(2)
    if p.returncode != 0:
        print(f"felix-format: clang-format failed on {filename}:\n{p.stderr}", file=sys.stderr)
        sys.exit(2)
    return p.stdout


def format_text(text, filename, use_clang=True, clang_exe="clang-format"):
    if use_clang:
        text = run_clang_format(text, filename, clang_exe)
        # main.m: if/else attach K&R ('if (...) {'), functions/for break
        # Allman. clang-format Allman breaks if too, so re-attach if/else.
        text = fix_if_braces(text)
    # Final safety: never emit tabs; always 4-space-wide (main.m + .editorconfig).
    text = text.replace("\t", "    ")
    return airy_pass(text)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="felix-format", description="clang-format + airy paragraph spacing")
    ap.add_argument("-i", "--in-place", action="store_true", help="edit files in place")
    ap.add_argument("--check", action="store_true", help="exit 1 if any file would change")
    ap.add_argument("--diff", action="store_true", help="show unified diffs")
    ap.add_argument("--no-clang", action="store_true", help="skip clang-format, airy pass only")
    ap.add_argument("--clang-format", default="clang-format", help="clang-format binary")
    ap.add_argument("files", nargs="*", help="C files (shell expands *.c)")
    args = ap.parse_args(argv)

    if not args.files:
        if sys.stdin.isatty():
            ap.print_help()
            return 2
        sys.stdout.write(format_text(sys.stdin.read(), "stdin.c", not args.no_clang, args.clang_format))
        return 0

    results = []
    rc = 0
    for path in args.files:
        try:
            with open(path, "r", encoding="utf-8") as f:
                orig = f.read()
        except OSError as e:
            print(f"felix-format: cannot read {path}: {e}", file=sys.stderr)
            rc = 2
            continue
        new = format_text(orig, path, not args.no_clang, args.clang_format)
        results.append((path, orig, new))

    changed = [(p, o, n) for p, o, n in results if o != n]

    if args.check:
        for p, _o, _n in changed:
            print(f"would reformat: {p}")
        return 1 if changed else rc

    if args.in_place:
        for p, _o, n in changed:
            with open(p, "w", encoding="utf-8") as f:
                f.write(n)
        return rc

    if args.diff or len(results) > 1:
        for p, o, n in changed:
            sys.stdout.write("".join(difflib.unified_diff(
                o.splitlines(True), n.splitlines(True),
                fromfile=p + " (orig)", tofile=p + " (felix)")))
        return rc

    # single file, no flags: behave like clang-format, print result
    sys.stdout.write(results[0][2])
    return rc


if __name__ == "__main__":
    sys.exit(main())
